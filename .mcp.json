{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.80",
        "--headless",
        "--isolated",
        "--allow-unrestricted-file-access",
        "--output-dir=.playwright-mcp"
      ]
    },
    "box-kite": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@box-kite/mcp"
      ]
    }
  }
}
