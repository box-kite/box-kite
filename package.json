{
  "name": "@box-kite/react",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": [
    "pages/**"
  ],
  "main": "./box.cjs",
  "module": "./box.mjs",
  "types": "./box.d.ts",
  "exports": {
    ".": {
      "react-server": {
        "types": "./rsc.d.ts",
        "import": "./rsc.mjs",
        "require": "./rsc.cjs"
      },
      "types": "./box.d.ts",
      "import": "./box.mjs",
      "require": "./box.cjs"
    },
    "./rsc": {
      "types": "./rsc.d.ts",
      "import": "./rsc.mjs",
      "require": "./rsc.cjs"
    },
    "./a11y": {
      "types": "./a11y.d.ts",
      "import": "./a11y.mjs",
      "require": "./a11y.cjs"
    },
    "./ssg": {
      "types": "./ssg.d.ts",
      "import": "./ssg.mjs",
      "require": "./ssg.cjs"
    },
    "./components/*": {
      "types": "./components/*.d.ts",
      "import": "./components/*.mjs",
      "require": "./components/*.cjs"
    }
  },
  "scripts": {
    "dev": "vite ./pages --config ./pages.vite.config.ts --mode dev",
    "dev:vanilla": "vite ./examples/vanilla --config ./examples/vanilla/vite.config.ts",
    "build:vanilla": "vite build ./examples/vanilla --config ./examples/vanilla/vite.config.ts",
    "pack:local": "node scripts/packLocal.mjs",
    "install:next-app": "npm run pack:local && npm --prefix examples/next-app install --no-package-lock",
    "dev:next-app": "npm run install:next-app && npm --prefix examples/next-app run dev",
    "build:next-app": "npm run install:next-app && npm --prefix examples/next-app run build",
    "smoke:next-app": "npm --prefix examples/next-app run smoke",
    "build:pages": "vite build ./pages --config ./pages.vite.config.ts --outDir ../dist-pages --mode production && npm run prerender:pages",
    "prerender:pages": "node scripts/prerender-pages.mjs",
    "preview": "vite preview ./pages --config ./pages.vite.config.ts --outDir ../dist-pages",
    "build": "npm run build:core && vite build",
    "build:core": "vite build --config vite.core.config.ts && node scripts/postbuild-core.mjs",
    "postbuild": "node scripts/postbuild.mjs",
    "build:bridge": "node scripts/build-bridge.mjs",
    "build:dev": "npm run build:core && vite build --mode dev",
    "compile": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:a11y": "vitest run a11y",
    "lint": "eslint .",
    "check:boundaries": "node scripts/check-core-boundary.mjs && node scripts/check-rsc-boundary.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "check:docs": "node scripts/check-docs-snippets.mjs",
    "check:props": "node scripts/check-props-api.mjs",
    "docs:props": "node scripts/check-props-api.mjs --fix",
    "check:components": "node scripts/check-components-api.mjs",
    "docs:components": "node scripts/check-components-api.mjs --fix",
    "check:agents": "node scripts/check-agent-files.mjs",
    "docs:agents": "node scripts/check-agent-files.mjs --fix",
    "check:package": "publint dist && attw --pack dist --ignore-rules false-esm cjs-resolves-to-esm internal-resolution-error && publint dist-core && attw --pack dist-core --ignore-rules false-esm cjs-resolves-to-esm internal-resolution-error",
    "size": "size-limit",
    "release": "node scripts/release.mjs"
  },
  "size-limit": [
    {
      "name": "Box core (main entry)",
      "path": "dist/box.mjs",
      "ignore": [
        "react",
        "react-dom"
      ],
      "gzip": true,
      "limit": "26.25 KB"
    },
    {
      "name": "Box in a Server Component (react-server entry)",
      "path": "dist/rsc.mjs",
      "ignore": [
        "react",
        "react-dom"
      ],
      "gzip": true,
      "limit": "24.77 KB"
    },
    {
      "name": "Behavior primitives (a11y entry)",
      "path": "dist/a11y.mjs",
      "ignore": [
        "react",
        "react-dom"
      ],
      "gzip": true,
      "limit": "3.13 KB"
    },
    {
      "name": "Core engine (@box-kite/core, no React)",
      "path": "dist-core/core.mjs",
      "gzip": true,
      "limit": "24.10 KB"
    },
    {
      "name": "DataGrid",
      "path": "dist/components/dataGrid.mjs",
      "ignore": [
        "react",
        "react-dom"
      ],
      "gzip": true,
      "limit": "54.63 KB"
    },
    {
      "name": "Full library (Box + ssg + every component)",
      "path": "dev/size-full.mjs",
      "ignore": [
        "react",
        "react-dom"
      ],
      "gzip": true,
      "limit": "60.88 KB"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/box-kite/box-kite.git"
  },
  "keywords": [
    "box-kite",
    "boxkite",
    "react",
    "box",
    "css-in-js",
    "atomic-css",
    "runtime-css",
    "styling",
    "design-system",
    "react-server-components",
    "rsc",
    "accessibility",
    "typescript"
  ],
  "author": "Maxim Procopenco",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/box-kite/box-kite/issues"
  },
  "homepage": "https://www.box-kite.dev",
  "description": "One React component with 215 typed CSS props that generates atomic CSS at runtime — no CSS files, no build step, renders in a Server Component.",
  "peerDependencies": {
    "react": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "csstype": "^3.2.3",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@iconify-json/simple-icons": "^1.2.94",
    "@iconify/react": "^6.0.2",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.1.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/use-sync-external-store": "^1.5.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.1",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.11",
    "prettier": "^3.9.6",
    "prismjs": "^1.30.0",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "size-limit": "^13.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
