{
  "name": "@box-kite/react",
  "version": "2.2.7",
  "type": "module",
  "sideEffects": [
    "pages/**"
  ],
  "main": "./box.cjs",
  "module": "./box.mjs",
  "types": "./box.d.ts",
  "exports": {
    ".": {
      "react-server": {
        "types": "./rsc.d.ts",
        "import": "./rsc.mjs",
        "require": "./rsc.cjs"
      },
      "types": "./box.d.ts",
      "import": "./box.mjs",
      "require": "./box.cjs"
    },
    "./rsc": {
      "types": "./rsc.d.ts",
      "import": "./rsc.mjs",
      "require": "./rsc.cjs"
    },
    "./a11y": {
      "types": "./a11y.d.ts",
      "import": "./a11y.mjs",
      "require": "./a11y.cjs"
    },
    "./anchor": {
      "types": "./anchor.d.ts",
      "import": "./anchor.mjs",
      "require": "./anchor.cjs"
    },
    "./catalog": {
      "types": "./catalog.d.ts",
      "import": "./catalog.mjs",
      "require": "./catalog.cjs"
    },
    "./interop": {
      "types": "./interop.d.ts",
      "import": "./interop.mjs",
      "require": "./interop.cjs"
    },
    "./date": {
      "types": "./date.d.ts",
      "import": "./date.mjs",
      "require": "./date.cjs"
    },
    "./spec": {
      "types": "./spec.d.ts",
      "import": "./spec.mjs",
      "require": "./spec.cjs"
    },
    "./ssg": {
      "types": "./ssg.d.ts",
      "import": "./ssg.mjs",
      "require": "./ssg.cjs"
    },
    "./components/*": {
      "types": "./components/*.d.ts",
      "import": "./components/*.mjs",
      "require": "./components/*.cjs"
    }
  },
  "scripts": {
    "dev": "vite ./pages --config ./pages.vite.config.ts --mode dev",
    "dev:vanilla": "vite ./examples/vanilla --config ./examples/vanilla/vite.config.ts",
    "build:vanilla": "vite build ./examples/vanilla --config ./examples/vanilla/vite.config.ts",
    "pack:local": "node scripts/packLocal.mjs",
    "install:next-app": "npm run pack:local && npm --prefix examples/next-app install --no-package-lock",
    "dev:next-app": "npm run install:next-app && npm --prefix examples/next-app run dev",
    "build:next-app": "npm run install:next-app && npm --prefix examples/next-app run build",
    "smoke:next-app": "npm --prefix examples/next-app run smoke",
    "build:pages": "vite build ./pages --config ./pages.vite.config.ts --outDir ../dist-pages --mode production && npm run prerender:pages",
    "prerender:pages": "node scripts/prerender-pages.mjs",
    "snapshot:templates": "node scripts/snapshot-templates.mjs",
    "preview": "vite preview ./pages --config ./pages.vite.config.ts --outDir ../dist-pages",
    "build": "npm run build:core && vite build",
    "build:core": "vite build --config vite.core.config.ts && node scripts/postbuild-core.mjs",
    "build:mcp": "vite build --config vite.mcp.config.ts && node scripts/postbuild-mcp.mjs",
    "build:create": "vite build --config vite.create.config.ts && node scripts/postbuild-create.mjs",
    "postbuild": "node scripts/postbuild.mjs",
    "build:dev": "npm run build:core && vite build --mode dev",
    "compile": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:a11y": "vitest run a11y",
    "lint": "eslint .",
    "check:boundaries": "node scripts/check-core-boundary.mjs && node scripts/check-rsc-boundary.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "check:docs": "node scripts/check-docs-snippets.mjs",
    "check:props": "node scripts/check-props-api.mjs",
    "docs:props": "node scripts/check-props-api.mjs --fix",
    "check:components": "node scripts/check-components-api.mjs",
    "docs:components": "node scripts/check-components-api.mjs --fix",
    "check:catalog": "node scripts/check-catalog-api.mjs",
    "docs:catalog": "node scripts/check-catalog-api.mjs --fix",
    "check:create": "node scripts/check-create-templates.mjs",
    "docs:create": "node scripts/check-create-templates.mjs --fix",
    "check:conventions": "node scripts/check-component-conventions.mjs",
    "check:agents": "node scripts/check-agent-files.mjs",
    "docs:agents": "node scripts/check-agent-files.mjs --fix",
    "check:package": "publint dist && attw --pack dist --ignore-rules false-esm cjs-resolves-to-esm internal-resolution-error && publint dist-core && attw --pack dist-core --ignore-rules false-esm cjs-resolves-to-esm internal-resolution-error && publint dist-mcp && publint dist-create",
    "bench": "node bench/run.mjs",
    "compare": "node dev/compare/report.mjs",
    "compare:tailwind": "node dev/compare/report.mjs tailwind",
    "compare:radix": "node dev/compare/report.mjs radix",
    "compare:grid": "node dev/compare/report.mjs grid",
    "size": "size-limit",
    "size:published": "node dev/published-size.mjs",
    "release": "node scripts/release.mjs"
  },
  "size-limit": [
    {
      "name": "Box core (main entry)",
      "path": "dist/box.mjs",
      "ignore": [
        "react",
        "react-dom",
        "./diagnostics-*",
        "./themeReveal-*"
      ],
      "gzip": true,
      "limit": "40.66 kB"
    },
    {
      "name": "Box in a Server Component (react-server entry)",
      "path": "dist/rsc.mjs",
      "ignore": [
        "react",
        "react-dom",
        "./diagnostics-*",
        "./themeReveal-*"
      ],
      "gzip": true,
      "limit": "38.30 kB"
    },
    {
      "name": "Behavior primitives (a11y entry)",
      "path": "dist/a11y.mjs",
      "ignore": [
        "react",
        "react-dom",
        "./diagnostics-*",
        "./themeReveal-*"
      ],
      "gzip": true,
      "limit": "3.47 kB"
    },
    {
      "name": "Anchor positioning (anchor entry)",
      "path": "dist/anchor.mjs",
      "ignore": [
        "react",
        "react-dom",
        "./diagnostics-*",
        "./themeReveal-*"
      ],
      "gzip": true,
      "limit": "2.25 KB"
