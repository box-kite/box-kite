        "isEmptyCell"
      ]
    },
    { "path": "datagrid.header.cell.contextMenu", "depth": 3, "extends": null, "variants": [] },
    { "path": "datagrid.header.cell.contextMenu.icon", "depth": 4, "extends": null, "variants": [] },
    { "path": "datagrid.header.cell.contextMenu.tooltip", "depth": 4, "extends": null, "variants": ["closed"] },
