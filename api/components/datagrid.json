    { "path": "datagrid.body.detailRow.content", "depth": 3, "extends": null, "variants": [] },
    { "path": "datagrid.body.row", "depth": 2, "extends": null, "variants": [] },
    { "path": "datagrid.body.groupRow", "depth": 2, "extends": null, "variants": [] },
    { "path": "datagrid.body.groupRow.expandButton", "depth": 3, "extends": null, "variants": [] },
    { "path": "datagrid.body.empty", "depth": 2, "extends": null, "variants": [] },
